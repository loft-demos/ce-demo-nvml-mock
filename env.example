# Copy to env.local (git-ignored), fill in, then: scripts/configure.sh env.local
# Everything lands in out/, ready to kubectl apply against the Platform's management API.

# The KubeVirt NodeProvider the simulated-GPU VMs come from.
KUBEVIRT_NODE_PROVIDER=my-kubevirt-provider
# Full NodeType names (<provider>.<type>). The short alias breaks consolidation of
# dynamic nodes; see docs/runbook.md.
MOCK_GPU_NODE_TYPE=my-kubevirt-provider.kvm-mock-gpu
# A CPU NodeType that avoids the mock GPU host (NVSentinel and dynamic templates).
CPU_NODE_TYPE=my-kubevirt-provider.kvm-medium
# Any always-available NodeType; the zero-limit headroom pool never launches it.
HEADROOM_NODE_TYPE=my-kubevirt-provider.kvm-small
# Metal3 (nvml-mock-metal3-cloud-init): the NodeProvider that has the simulated GPU
# server NodeType (platform/metal3/node-type-snippet.yaml).
METAL3_NODE_PROVIDER=my-metal3-provider
# nvml-mock-metal3-nvsentinel-dynamic: full NodeType names for the CPU service node
# (2+ CPU, 4+ GiB) and an always-available type for the zero-limit headroom pool.
METAL3_CPU_NODE_TYPE=my-metal3-provider.medium
METAL3_HEADROOM_NODE_TYPE=my-metal3-provider.small
# The Argo CD connector tenant clusters register with (Stacks deploy through it).
ARGOCD_CONNECTOR=my-argocd
# Tenant cluster CIDRs. Must not overlap the KubeVirt provider cluster's pod and
# service CIDRs (the VMs' node IPs are provider pod IPs).
TENANT_POD_CIDR=10.244.0.0/16
TENANT_SERVICE_CIDR=10.96.0.0/16
# A Git repo Argo CD can read that contains charts/gpu-workload (a fork of this repo).
GPU_WORKLOAD_REPO_URL=https://github.com/your-org/ce-demo-nvml-mock.git
